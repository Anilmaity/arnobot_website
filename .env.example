# ─────────────────────────────────────────────────────────────
# SMTP — used by /api/contact, /api/career and /api/schedule-demo
# The original PHP scripts hard-coded a Gmail account and app password
# inside contact_submit.php / career_submit.php / schedule_demo_submit.php.
# Copy those values here (or, preferably, issue a fresh app password).
# Without SMTP_USER + SMTP_PASS the forms validate but cannot send mail.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Envelope addresses (defaults match the PHP scripts)
MAIL_FROM=contact@arnobot.in
MAIL_TO=contact@arnobot.in

# Logo shown at the top of the HTML contact/career emails
MAIL_LOGO_URL=https://nites.in/arnobot/assets/logos/logo-white.png

# ─────────────────────────────────────────────────────────────
# Google reCAPTCHA v2 (contact form)
# The site key is public; the secret was hard-coded in contact_submit.php.
# If RECAPTCHA_SECRET_KEY is unset, the server still requires a token to be
# present but skips the siteverify round-trip.
# ─────────────────────────────────────────────────────────────

