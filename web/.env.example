# Copy to .env.local and fill in. Required by the hiring-assistant routes
# (/apply, /admin, /api/*). The marketing site works without these.

# Postgres connection string. Tables + the question bank auto-create and seed
# on first request — no manual migration needed.
#
# Local Postgres:
DATABASE_URL=postgres://user:password@localhost:5432/arnobot
#
# Hosted Postgres (AWS RDS/Lightsail, Neon, Supabase, Railway, …) requires SSL —
# append ?sslmode=require. Example (fill in your own host/user/password/db):
# DATABASE_URL=postgres://USER:PASSWORD@YOUR-DB-HOST:5432/DBNAME?sslmode=require

# Password for the /admin dashboard.
ADMIN_PASSWORD=change-me

# Long random string for signing attempt + admin-session tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me

# Optional quiz tuning (defaults shown).
QUIZ_QUESTIONS_PER_TEST=20
QUIZ_PASS_PERCENT=70
QUIZ_TIME_LIMIT_MIN=20
